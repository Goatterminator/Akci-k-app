# Ingyenes Gemini API kulcs: https://aistudio.google.com/apikey
# (A webes felület Beállítások oldalán is megadható.)
GEMINI_API_KEY=

# Port, amin az app figyel (Tailscale-en: http://<pi-neve>:8090)
# A 8080-at szándékosan kerüljük, mert gyakran foglalt (pl. más projekt).
PORT=8090

# Adatbázis helye
DATA_DIR=./data
